# ==============================================================
# KONFIGURASI ENVIRONMENT AGENDA BACKEND
# ==============================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env

# Port server saat dijalankan secara lokal (default: 3000)
PORT=3000

# Kunci rahasia untuk tanda tangan JSON Web Token (JWT)
# Gunakan teks acak dan panjang untuk keamanan produksi
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang-dan-aman

# --------------------------------------------------------------
# 1. DATABASE (SQLite Lokal vs Turso Cloud)
# --------------------------------------------------------------
# Set USE_LOCAL_DB=true jika ingin latihan secara offline (pakai jadwal.db lokal).
# Set USE_LOCAL_DB=false jika ingin terhubung ke database cloud Turso (libSQL).
USE_LOCAL_DB=false

# Kredensial Turso (diperlukan jika USE_LOCAL_DB=false):
# - Dapatkan URL:   turso db show <db-name> --url
# - Dapatkan Token: turso db tokens create <db-name>
TURSO_DATABASE_URL=libsql://agenda-db-username.turso.io
TURSO_AUTH_TOKEN=eyJh...turso_auth_token...

# --------------------------------------------------------------
# 2. STORAGE CLOUD (Supabase Storage)
# --------------------------------------------------------------
# Supabase digunakan untuk menyimpan file materi (PDF, gambar, docx, dll).
# Ambil dari: Dashboard Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# PENTING: Gunakan service_role key (bukan anon key)
# karena backend butuh hak akses penuh untuk upload/delete di bucket private.
SUPABASE_SERVICE_KEY=eyJh...supabase_service_role_key...

# Nama Bucket di Supabase Storage (dibuat dengan opsi 'Private')
SUPABASE_BUCKET=materi

# --------------------------------------------------------------
# 3. FITUR TAMBAHAN (Opsional)
# --------------------------------------------------------------
# API Key Google Gemini (jika mengaktifkan fitur kuis otomatis / AI)
GEMINI_API_KEY=
